# ---------------------------------------------------------------
# Tebras Intelligence — variáveis de ambiente (EXEMPLO, sem segredos reais)
# Copie para .env.local (desenvolvimento) e preencha os valores.
# Nunca versione arquivos .env com valores reais.
# ---------------------------------------------------------------

# Ambiente lógico: development | test | production
APP_ENV=development

# URL pública da aplicação (usada em links de redefinição de senha)
APP_URL=http://localhost:3000

# Fuso horário padrão das datas exibidas
APP_TIMEZONE=America/Sao_Paulo

# Conexão PostgreSQL (local, Supabase, Neon, RDS...).
# Em produção use SSL (ex.: ?sslmode=require).
DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/tebras_intelligence

# Banco exclusivo para testes automatizados (será apagado e recriado pelos testes!)
TEST_DATABASE_URL=postgres://USUARIO:SENHA@localhost:5432/tebras_intelligence_test

# Duração da sessão em horas
SESSION_TTL_HOURS=12

# Ambiente de demonstração com dados fictícios. NUNCA habilitar em produção.
DEMO_MODE=false



# Tebras Intelligence (ver docs/INTELLIGENCE.md). Vazio = servidores públicos (somente uso leve/desenvolvimento).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=
# NOMINATIM_URL= OVERPASS_URL= IBGE_API_URL=
# INTEL_USER_AGENT="TebrasIntelligence/1.0 (contato@seudominio)"
OPEN_CHARGE_MAP_API_KEY=
